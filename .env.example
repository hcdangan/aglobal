# ---------------------------------------------------------------------------
# AGlobal Care, Inc. — environment variables
# Copy to `.env.local` and adjust. Both variables are optional.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadata, Open Graph tags, the sitemap,
# robots.txt and JSON-LD. Do NOT include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.aglobalcare.com

# Optional form backend / serverless endpoint that accepts a multipart POST.
# Works with Formspree, Basin, Getform, Netlify Forms, or your own function.
# Leave unset and the contact form falls back to opening a prefilled mail draft,
# so the static build is fully functional either way.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
