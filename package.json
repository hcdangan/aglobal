{
  "name": "aglobal-care-web",
  "version": "1.0.0",
  "private": true,
  "description": "Modernized marketing website for AGlobal Care, Inc. — Changing human life globally.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/check-css-urls.mjs source && node scripts/check-css-urls.mjs selftest",
    "guard": "node scripts/check-css-urls.mjs build",
    "verify": "npm run preflight && npm run typecheck && npm run lint && npm run build && npm run guard"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@tailwindcss/oxide": true,
    "sharp": true
  }
}
